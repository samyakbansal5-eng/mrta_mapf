# ---- Gemini (used only by /api/convert, server side; never exposed to the browser) ----
# Create a key in Google AI Studio and put it in Vercel -> Project -> Settings -> Environment Variables.
GEMINI_API_KEY=
# Gemini model name, e.g. the current "flash" or "pro" model with image input. Left blank on purpose.
GEMINI_MODEL=

# ---- Optional protection for the public site ----
# If set, /api/convert requires this code (sent as the x-access-code header from the Import screen).
APP_ACCESS_CODE=
# Requests per IP per 10 minutes for /api/convert (best-effort, in-memory).
CONVERT_RATE_LIMIT=10
