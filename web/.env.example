# ---- Claude (used only by /api/convert, server side; never exposed to the browser) ----
# Create a key at platform.claude.com -> API keys, and put it in Vercel -> Project -> Settings -> Environment Variables.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5 (cheapest). Thinking is off and effort is "low" unless ANTHROPIC_EFFORT says otherwise.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# ---- Optional protection for the public site ----
# If set, /api/convert requires this code (sent as the x-access-code header from the Import screen).
APP_ACCESS_CODE=
# Requests per IP per 10 minutes for /api/convert (best-effort, in-memory).
CONVERT_RATE_LIMIT=10
